{
  "name": "plantilla-startup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plantilla de app para las startups del Taller Emprendedor (Vite + React + Firebase).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulador": "vite --mode emulador",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-vacacionapp",
    "seed": "tsx scripts/seed.ts",
    "admin:dar": "tsx scripts/admin-dar.ts",
    "admin:dar:prod": "tsx scripts/admin-dar.ts --produccion",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-vacacionapp \"vitest run\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-vacacionapp \"playwright test\"",
    "test": "npm run test:reglas && npm run test:e2e",
    "deploy:reglas": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@firebase/app": "0.16.5",
    "@firebase/app-compat": "0.5.21"
  }
}
