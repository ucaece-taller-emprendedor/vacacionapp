# Copiá este archivo a .env y completá tus valores. No subas .env al repo.

# Conexión a Postgres (Neon). Formato: postgresql://usuario:clave@host/base?sslmode=require
DATABASE_URL=

# Secreto de Better Auth. Generá uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app (en local: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
