# Copiá este archivo a .env y completá tus valores. No subas .env al repo.
# Las variables se validan al arrancar (lib/env.ts): si falta alguna, el error te dice cuál.

# Conexión a Postgres (Neon u otro). Formato: postgresql://usuario:clave@host/base?sslmode=require
DATABASE_URL=

# Secreto de Better Auth (mínimo 32 caracteres). Generá uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app (en local: http://localhost:3000; en producción: la URL de tu deploy)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (opcional). Si dejás estas dos vacías, el botón "Continuar con Google" queda deshabilitado.
# Creá un cliente OAuth en Google Cloud Console y cargá estas URLs de redirección:
#   http://localhost:3000/api/auth/callback/google
#   https://<tu-dominio>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails (separados por coma) que entran como administradores al ingresar con Google (email verificado).
# Ejemplo: ADMIN_EMAILS=docente@universidad.edu.ar,otro@gmail.com
ADMIN_EMAILS=
