# Copiá este archivo a .env y completá con la config web de tu proyecto Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Configuración del SDK).
# Estos valores NO son secretos (van en el navegador igual), pero .env no se sube a git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
